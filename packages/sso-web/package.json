{
	"name": "@koch/sso-web",
	"version": "0.1.0",
	"description": "Preset de frontend para apps atrás do forwardAuth do authentik: denylist do service worker e recuperação de sessão",
	"license": "UNLICENSED",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"axios": "^1.13.0",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
