{
	"name": "@koch/authentik-auth",
	"version": "0.1.0",
	"description": "Validação do X-authentik-jwt (forwardAuth do Traefik + authentik) e adapters Express/Fastify/Nest",
	"license": "UNLICENSED",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./express": {
			"import": {
				"types": "./dist/express.d.mts",
				"default": "./dist/express.mjs"
			},
			"require": {
				"types": "./dist/express.d.cts",
				"default": "./dist/express.cjs"
			}
		},
		"./fastify": {
			"import": {
				"types": "./dist/fastify.d.mts",
				"default": "./dist/fastify.mjs"
			},
			"require": {
				"types": "./dist/fastify.d.cts",
				"default": "./dist/fastify.cjs"
			}
		},
		"./nest": {
			"import": {
				"types": "./dist/nest.d.mts",
				"default": "./dist/nest.mjs"
			},
			"require": {
				"types": "./dist/nest.d.cts",
				"default": "./dist/nest.cjs"
			}
		},
		"./consinco": {
			"import": {
				"types": "./dist/consinco.d.mts",
				"default": "./dist/consinco.mjs"
			},
			"require": {
				"types": "./dist/consinco.d.cts",
				"default": "./dist/consinco.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"jose": "^6.2.5"
	},
	"peerDependencies": {
		"@nestjs/common": "^11",
		"express": "^4 || ^5",
		"fastify": "^5"
	},
	"peerDependenciesMeta": {
		"@nestjs/common": {
			"optional": true
		},
		"express": {
			"optional": true
		},
		"fastify": {
			"optional": true
		}
	},
	"devDependencies": {
		"@nestjs/common": "^11.1.0",
		"@nestjs/core": "^11.1.0",
		"@nestjs/platform-express": "^11.1.0",
		"@nestjs/testing": "^11.1.0",
		"@types/express": "^5.0.0",
		"@types/node": "catalog:",
		"@types/supertest": "^6.0.0",
		"express": "^5.1.0",
		"fastify": "^5.12.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.0",
		"supertest": "^7.1.0",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
